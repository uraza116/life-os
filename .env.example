# Copy this file to .env and fill it in. Never commit .env.

# SQLite database file. Keep it outside OneDrive/Dropbox so syncing can't corrupt it.
DATABASE_URL="file:C:/Users/<you>/AppData/Local/LifeOS/life-os.db"

# Optional AI provider (planned for a later phase). The app works fully without these.
AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
